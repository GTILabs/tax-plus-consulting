# Public base URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow search engines to index the site. Keep false on staging.
SITE_INDEXABLE=false

# Show the editorial notes from the staging design ("untuk diisi", etc.).
SHOW_STAGING_NOTES=false

# Neon Postgres, provisioned through the Vercel Marketplace.
# Fetch real values with: vercel env pull .env.local
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Resend (Vercel Marketplace) for consultation notifications and admin password resets.
# Without it emails are skipped and logged.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
EMAIL_FROM="TaxPlus Consulting <noreply@taxplus-consulting.co.id>"

# Google Analytics 4: web stream measurement ID (tracking on the public site).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin dashboard (/admin/analytics): numeric property ID and the service account JSON key
# (raw or base64) with Viewer access on the property.
GA4_PROPERTY_ID=
GA4_CREDENTIALS=
