# Public base URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow search engines to index the site. Keep false on staging.
SITE_INDEXABLE=false

# Show the editorial notes from the staging design ("untuk diisi", etc.).
SHOW_STAGING_NOTES=false

# Neon Postgres, provisioned through the Vercel Marketplace.
# Fetch real values with: vercel env pull .env.local
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
